@inject AuthenticationStateProvider AuthProvider
@inject IDataService DataService
@inject IDataService DataService
@inject IThemeProvider ThemeProvider

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=550, user-scalable=no" />
    <title>@_title</title>
    <base href="/" />
    <link href="css/site.css" rel="stylesheet" />
    <link href="Remotely_Server.styles.css" rel="stylesheet" />
    <script src="interop.js"></script>

    @if (_theme == Theme.Dark)
    {
        <link rel="stylesheet" href="/css/Themes/darkly.min.css" />
        <link rel="stylesheet" href="/css/Themes/darkly.custom.css" />
    }
    else
    {
        <link rel="stylesheet" href="/css/Themes/yeti.min.css" />
        <link rel="stylesheet" href="/css/Themes/yeti.custom.css" />
    }

    <HeadOutlet @rendermode="RenderModeForPage" />
</head>
<body>
    <Routes @rendermode="RenderModeForPage" />
    @* Fenêtre de reconnexion en français : sans cet élément, blazor.web.js affiche la sienne, en anglais
       (redémarrage du serveur, coupure réseau). Il lui ajoute les classes components-reconnect-*. *@
    <div id="components-reconnect-modal" data-nosnippet>
        <div class="reconnect-box">
            <p class="reconnect-first">Connexion au serveur perdue. Reconnexion…</p>
            <p class="reconnect-repeated">Reconnexion impossible pour l'instant. Nouvel essai dans <span id="components-seconds-to-next-attempt"></span> s.</p>
            <p class="reconnect-failed">Reconnexion impossible. <button type="button" class="btn btn-sm btn-primary" onclick="Blazor.reconnect()">Réessayer</button> <button type="button" class="btn btn-sm btn-secondary" onclick="location.reload()">Recharger la page</button></p>
            <p class="reconnect-rejected">Le serveur a redémarré : rechargement de la page… <button type="button" class="btn btn-sm btn-primary" onclick="location.reload()">Recharger la page</button></p>
            <p class="reconnect-paused">Session mise en pause par le serveur. <button type="button" class="btn btn-sm btn-primary" onclick="Blazor.resumeCircuit()">Reprendre</button></p>
            <p class="reconnect-resume-failed">Impossible de reprendre la session. <button type="button" class="btn btn-sm btn-primary" onclick="location.reload()">Recharger la page</button></p>
        </div>
    </div>
    <script>
        // Session perdue (serveur redémarré) : rien à reprendre, la page se recharge seule.
        document.getElementById("components-reconnect-modal").addEventListener("components-reconnect-state-changed",
            e => { if (e.detail.state === "rejected") location.reload(); });
    </script>
    <script src="_framework/blazor.web.js"></script>
    <script src="/lib/bootstrap/bootstrap.bundle.min.js"></script>
</body>
</html>

@code
{
    [CascadingParameter]
    public required HttpContext HttpContext { get; set; }

    private RemotelyUser? _user;
    private Theme _theme;
    private string _title = "Amarre";

    protected override async Task OnInitializedAsync()
    {
        _theme = await ThemeProvider.GetEffectiveTheme();
        var state = await AuthProvider.GetAuthenticationStateAsync();
        if (state.User.Identity is { IsAuthenticated: true } identity)
        {
            var userResult = await DataService.GetUserByName($"{identity.Name}");
            if (userResult.IsSuccess)
            {
                _user = userResult.Value;
            }
        }

        // Nom de l'organisation de l'utilisateur, sinon celui de l'organisation par défaut.
        var orgName = _user?.Organization?.OrganizationName;
        if (string.IsNullOrWhiteSpace(orgName))
        {
            var orgResult = !string.IsNullOrWhiteSpace(_user?.OrganizationID)
                ? await DataService.GetOrganizationById(_user.OrganizationID)
                : await DataService.GetDefaultOrganization();
            orgName = orgResult.IsSuccess ? orgResult.Value.OrganizationName : null;
        }
        if (!string.IsNullOrWhiteSpace(orgName))
        {
            _title = orgName;
        }

        await base.OnInitializedAsync();
    }


    private IComponentRenderMode? RenderModeForPage => 
        HttpContext.Request.Path.StartsWithSegments("/Account")
            ? null
            : InteractiveServer;
}