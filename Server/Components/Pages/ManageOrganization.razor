@page "/manage-organization"
@attribute [Authorize(Policy = PolicyNames.OrganizationAdminRequired)]
@inherits AuthComponentBase

<h3 class="mb-3">Organisation</h3>

@if (_isLoading)
{
    <h5>Chargement…</h5>
}
else if (User is not null)
{
    <div class="row">
        <div class="col-sm-8">
            @* Organization ID *@
            <div class="form-group mw">
                <label class="mb-1">ID de l'organisation</label>
                <input readonly class="form-control" value="@_organization?.ID" />
            </div>
        </div>
    </div>


    <div class="row">
        <div class="col-sm-8">
            @* Organization Name *@
            <div class="form-group mw">
                <label class="mb-1">Nom de l'organisation</label>

                <div class="input-group">
                    <input @onchange="OrganizationNameChanged"
                           value="@_organization?.OrganizationName"
                           maxlength="25"
                           placeholder="Nom de l'organisation" 
                           class="form-control" 
                           autocomplete="off" />
                </div>
                <div class="text-muted small">
                    * Actualiser le navigateur pour l'appliquer.
                </div>
            </div>
            @if (User.IsServerAdmin)
            {
                <div class="form-group">
                    <label class="mb-1">Organisation par défaut du serveur</label>
                    <button class="btn btn-sm btn-secondary ms-2" @onclick="ShowDefaultOrgHelp">
                        <span class="oi oi-question-mark"></span>
                    </button>
                    <br />
                    <input type="checkbox" checked="@_organization?.IsDefaultOrganization" @onchange="DefaultOrgCheckChanged" />
                </div>
            }
        </div>
    </div>

    <div class="row">
        <div class="col-sm-8">
            @* Device Groups *@
            <div class="form-group">
                <label class="mb-1">Groupes d'appareils</label>
                <button class="btn btn-sm btn-secondary ms-2" @onclick="ShowDeviceGroupHelp">
                    <span class="oi oi-question-mark"></span>
                </button>

                <select class="form-control mb-1" @bind="_selectedDeviceGroupId" size="4">
                    @foreach (var deviceGroup in _deviceGroups)
                    {
                        <option @key="deviceGroup.ID" value="@deviceGroup.ID">@deviceGroup.Name</option>
                    }
                </select>

                <div class="text-end mb-3">
                    <button type="button" class="btn btn-danger" @onclick="DeleteSelectedDeviceGroup">Supprimer</button>
                </div>

                <div class="input-group">
                    <input placeholder="Nouveau groupe" class="form-control" maxlength="200"
                           @bind="_newDeviceGroupName"
                           @bind:event="oninput"
                           @onkeypress="EvaluateNewDeviceGroupKeyPress" />
                    <button type="submit" class="btn btn-secondary" @onclick="CreateNewDeviceGroup">Ajouter</button>
                </div>
            </div>

        </div>
    </div>

    <div class="row">
        <div class="col-sm-12">
            @* Users *@
            <div class="form-group">
                <label class="control-label">Utilisateurs</label>
                <button class="btn btn-sm btn-secondary ms-2" @onclick="ShowUsersHelp">
                    <span class="oi oi-question-mark"></span>
                </button>
                <table class="table table-striped table-hover" style="max-height: 400px">
                    <thead>
                        <tr>
                            <th>Utilisateur</th>
                            <th>Administrateur</th>
                            <th>Groupes</th>
                            <th>Mot de passe</th>
                            <th>Supprimer</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var orgUser in _orgUsers)
                        {
                            <tr @key="orgUser.Id">
                                <td class="middle-aligned"><label class="control-label">@orgUser.UserName</label></td>
                                @if (User.Id == orgUser.Id)
                                {
                                    <td><input type="checkbox" readonly disabled checked="@orgUser.IsAdministrator" /></td>
                                    <td><button type="button" class="btn btn-secondary" title="Modifier" @onclick="() => EditDeviceGroups(orgUser)">Modifier</button></td>
                                    <td></td>
                                    <td><button type="button" class="btn btn-danger delete-user-button" disabled>Supprimer</button></td>
                                }
                                else
                                {
                                    <td><input type="checkbox" @onchange="(ev) => SetUserIsAdmin(ev, orgUser)" checked="@orgUser.IsAdministrator" /></td>
                                    <td><button type="button" class="btn btn-secondary" title="Modifier" @onclick="() => EditDeviceGroups(orgUser)">Modifier</button></td>
                                    <td><button type="button" class="btn btn-danger" title="Réinitialiser le mot de passe" @onclick="() => ResetPassword(orgUser)">Réinitialiser</button></td>
                                    <td><button type="button" class="btn btn-danger" title="Supprimer l'utilisateur" @onclick="() => DeleteUser(orgUser)">Supprimer</button></td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>


    @* Invitations *@
    <div class="row">
        <div class="col-sm-12">
            <div class="form-group">
                <label class="control-label">Invitations</label>
                <button class="btn btn-sm btn-secondary ms-2" @onclick="ShowInvitesHelp">
                    <span class="oi oi-question-mark"></span>
                </button>
                <table id="invitesTable" class="table table-striped table-hover" style="max-height: 400px">
                    <thead>
                        <tr>
                            <th>Invité</th>
                            <th>Administrateur</th>
                            <th>Lien</th>
                            <th>Supprimer</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var invite in _invites)
                        {
                            <tr @key="invite.ID">
                                <td class="middle-aligned"><label class="control-label">@invite.InvitedUser</label></td>
                                <td class="middle-aligned"><input type="checkbox" checked="@invite.IsAdmin" disabled /></td>
                                <td class="middle-aligned">
                                    <label class="control-label">
                                        <a href="@(NavManager.BaseUri)Invite/@invite.ID">Lien d'invitation</a>
                                    </label>
                                </td>
                                <td><button type="button" class="btn btn-danger" invite="@invite.ID" @onclick="() => DeleteInvite(invite)">Supprimer</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>


    @* Send Invites *@
    <div class="row">
        <div class="col-sm-8">
            <div class="text-danger"></div>
            <div class="form-group">
                <label class="control-label">Ajouter un utilisateur</label>
                <div class="input-group">
                    <input @bind="_inviteEmail" @bind:event="oninput"
                           placeholder="Adresse e-mail"
                           type="email"
                           required
                           class="form-control" />

                    <span class="input-group-text pe-1">Administrateur</span>
                    <div class="input-group-text ps-1">
                        <input @bind="_inviteAsAdmin" type="checkbox" @onkeypress="EvaluateInviteInputKeypress" />
                    </div>
                    <button type="button" class="btn btn-primary" @onclick="SendInvite">Ajouter</button>
                </div>
            </div>
        </div>
    </div>

}