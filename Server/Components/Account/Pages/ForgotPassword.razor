@page "/Account/ForgotPassword"

@using System.ComponentModel.DataAnnotations
@using System.Diagnostics
@using System.Text
@using System.Text.Encodings.Web
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using Remotely.Server.Data

@inject UserManager<RemotelyUser> UserManager
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager
@inject IDataService DataService
@inject IServiceScopeFactory ScopeFactory
@inject ILogger<ForgotPassword> Logger

<PageTitle>Mot de passe oublié</PageTitle>

<h1>Mot de passe oublié ?</h1>
<h2>Saisissez votre adresse e-mail.</h2>
<hr />
<div class="row">
    <div class="col-md-4">
        <EditForm Model="Input" FormName="forgot-password" OnValidSubmit="OnValidSubmitAsync" method="post">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert" />

            <div class="form-floating mb-3">
                <InputText @bind-Value="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                <label for="email" class="form-label">Adresse e-mail</label>
                <ValidationMessage For="() => Input.Email" class="text-danger" />
            </div>
            <button type="submit" class="w-100 btn btn-lg btn-primary">Réinitialiser le mot de passe</button>
        </EditForm>
     </div>
</div>

@code {
    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    protected override void OnInitialized()
    {
        Input ??= new();
    }

    // Même réponse, dans le même temps, qu'un compte existe ou non : l'e-mail part en arrière-plan
    // et la réponse attend au moins ce délai dans les deux cas.
    private static readonly TimeSpan MinimumResponseTime = TimeSpan.FromMilliseconds(400);

    // Au plus 3 e-mails de réinitialisation par compte et par quart d'heure (au-delà : même réponse, rien n'est envoyé).
    private static readonly AttemptLimiter ResetEmails = new(3, TimeSpan.FromMinutes(15));

    private async Task OnValidSubmitAsync()
    {
        var stopwatch = Stopwatch.StartNew();
        var user = await UserManager.FindByEmailAsync(Input.Email);
        // if (user is null || !(await UserManager.IsEmailConfirmedAsync(user)))
        // Confirmation is currently disabled by default.
        if (user is not null && ResetEmails.TryRecord(user.Id))
        {
            // For more information on how to enable account confirmation and password reset please
            // visit https://go.microsoft.com/fwlink/?LinkID=532713
            var code = await UserManager.GeneratePasswordResetTokenAsync(user);
            code = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(code));
            var settings = await DataService.GetSettings();
            var callbackUrl = AccountLinks.Build(
                NavigationManager,
                settings,
                "Account/ResetPassword",
                new Dictionary<string, object?> { ["code"] = code });

            var email = Input.Email;
            _ = Task.Run(() => SendResetLinkAsync(user, email, callbackUrl));
        }

        var remaining = MinimumResponseTime - stopwatch.Elapsed;
        if (remaining > TimeSpan.Zero)
        {
            await Task.Delay(remaining);
        }

        RedirectManager.RedirectTo("Account/ForgotPasswordConfirmation");
    }

    // Portée de services propre : celle de la requête est libérée pendant l'envoi.
    private async Task SendResetLinkAsync(RemotelyUser user, string email, string callbackUrl)
    {
        try
        {
            await using var scope = ScopeFactory.CreateAsyncScope();
            var emailSender = scope.ServiceProvider.GetRequiredService<IEmailSender<RemotelyUser>>();
            await emailSender.SendPasswordResetLinkAsync(user, email, HtmlEncoder.Default.Encode(callbackUrl));
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error while sending the password reset e-mail.");
        }
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Ce champ est obligatoire.")]
        [EmailAddress(ErrorMessage = "Adresse e-mail invalide.")]
        public string Email { get; set; } = "";
    }
}
